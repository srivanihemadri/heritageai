# ==========================================
# HeritageAI Environment Variables
# ==========================================

# -----------------------------
# Application
# -----------------------------
APP_NAME=HeritageAI
APP_ENV=development
APP_DEBUG=true

# -----------------------------
# Frontend
# -----------------------------
NEXT_PUBLIC_APP_NAME=HeritageAI
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# -----------------------------
# Backend
# -----------------------------
API_HOST=0.0.0.0
API_PORT=8000

SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------
# PostgreSQL
# -----------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=heritageai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

DATABASE_URL=postgresql://postgres:password@localhost:5432/heritageai

# -----------------------------
# Cloudinary
# -----------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------
# Gemini AI
# -----------------------------
GEMINI_API_KEY=

# -----------------------------
# Google Maps
# -----------------------------
GOOGLE_MAPS_API_KEY=

# -----------------------------
# CORS
# -----------------------------
ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------
# File Upload
# -----------------------------
MAX_UPLOAD_SIZE_MB=20

# -----------------------------
# Logging
# -----------------------------
LOG_LEVEL=INFO